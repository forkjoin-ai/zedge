{
  "name": "edge-ai",
  "projectType": "library",
  "sourceRoot": "open-source/zedge/src",
  "tags": [
    "scope:open-source",
    "type:lib"
  ],
  "targets": {
    "build": {
      "executor": "a0:run-commands",
      "options": {
        "command": "echo 'zedge: Rust extension built via cargo, companion hosted on x-gnosis + monster launcher'"
      }
    },
    "build:companion": {
      "executor": "a0:run-commands",
      "options": {
        "command": "node open-source/zedge/companion/scripts/build-companion-dist.mjs"
      }
    },
    "dev": {
      "executor": "a0:run-commands",
      "options": {
        "command": "open-source/zedge/scripts/run-ts-entry.sh open-source/zedge/companion/src/companion-supervisor.ts",
        "cwd": "."
      }
    },
    "start": {
      "executor": "a0:run-commands",
      "dependsOn": [
        "build:companion"
      ],
      "options": {
        "command": "node open-source/zedge/companion/dist/companion-supervisor.mjs",
        "cwd": "."
      }
    },
    "doctor": {
      "executor": "a0:run-commands",
      "options": {
        "command": "open-source/zedge/scripts/zedge-doctor.sh",
        "cwd": "."
      }
    },
    "test": {
      "executor": "a0:run-commands",
      "options": {
        "command": "pnpm run monster -- test open-source/zedge/companion/src/__tests__/auth.test.ts open-source/zedge/companion/src/__tests__/config.test.ts open-source/zedge/companion/src/__tests__/edit-preview.test.ts open-source/zedge/companion/src/__tests__/fim-cache.test.ts open-source/zedge/companion/src/__tests__/latency-probe.test.ts open-source/zedge/companion/src/__tests__/mcp-babysitter.test.ts open-source/zedge/companion/src/__tests__/parse-code-blocks.test.ts open-source/zedge/companion/src/__tests__/prompt-budget.test.ts open-source/zedge/companion/src/__tests__/runtime-command.test.ts open-source/zedge/companion/src/__tests__/tts-relay.test.ts open-source/zedge/companion/src/__tests__/vfs-bridge.test.ts open-source/zedge/companion/src/__tests__/zed-settings.test.ts"
      }
    },
    "test:all": {
      "executor": "a0:run-commands",
      "options": {
        "command": "find open-source/zedge/companion/src/__tests__ -name '*.test.ts' ! -name '*e2e.test.ts' -print | sort | xargs pnpm run monster -- test"
      }
    },
    "test:e2e": {
      "executor": "a0:run-commands",
      "options": {
        "command": "find open-source/zedge/companion/src/__tests__ -name '*e2e.test.ts' -print | sort | xargs pnpm run monster -- test"
      }
    },
    "typecheck": {
      "executor": "a0:run-commands",
      "options": {
        "command": "pnpm exec tsc -p open-source/zedge/companion/tsconfig.typecheck.json --noEmit"
      }
    },
    "lint": {
      "executor": "a0:run-commands",
      "options": {
        "command": "pnpm exec eslint open-source/zedge/companion/src open-source/zedge/scripts --ext .ts"
      }
    },
    "github:push": {
      "executor": "a0:run-commands",
      "options": {
        "command": "pnpm run monster -- scripts/open-source-repo-target.mjs github-push open-source/zedge",
        "cwd": "."
      }
    },
    "forge:push": {
      "executor": "a0:run-commands",
      "options": {
        "command": "pnpm run monster -- scripts/open-source-repo-target.mjs forge-push open-source/zedge",
        "cwd": "."
      }
    },
    "push": {
      "executor": "a0:run-commands",
      "options": {
        "command": "pnpm run monster -- scripts/open-source-repo-target.mjs push open-source/zedge",
        "cwd": "."
      }
    },
    "submodule:update-reference": {
      "executor": "a0:run-commands",
      "options": {
        "command": "pnpm run monster -- scripts/open-source-repo-target.mjs submodule-update-reference open-source/zedge",
        "cwd": "."
      }
    },
    "pr:list": {
      "executor": "a0:run-commands",
      "options": {
        "command": "pnpm run monster -- scripts/open-source-repo-target.mjs pr-list open-source/zedge",
        "cwd": "."
      }
    },
    "pr:merge-all": {
      "executor": "a0:run-commands",
      "options": {
        "command": "pnpm run monster -- scripts/open-source-repo-target.mjs pr-merge-all open-source/zedge",
        "cwd": "."
      }
    }
  }
}
