{
  "name": "zedge",
  "projectType": "library",
  "sourceRoot": "open-source/zedge/src",
  "tags": ["scope:open-source", "type:lib"],
  "targets": {
    "build": {
      "executor": "a0:run-commands",
      "options": {
        "command": "echo 'zedge: Rust extension built via cargo, companion via gnode'"
      }
    },
    "build:companion": {
      "executor": "a0:run-commands",
      "options": {
        "command": "pnpm exec esbuild companion/src/index.ts --bundle --outdir=companion/dist --platform=node --format=esm --minify",
        "cwd": "open-source/zedge"
      }
    },
    "test": {
      "executor": "a0:run-commands",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "command": "pnpm jest --config companion/jest.config.ts",
        "cwd": "{workspaceRoot}/open-source/zedge"
      }
    },
    "typecheck": {
      "executor": "a0:run-commands",
      "options": {
        "command": "../../node_modules/.bin/tsc -p companion/tsconfig.json --noEmit",
        "cwd": "open-source/zedge"
      }
    },
    "lint": {
      "executor": "a0:run-commands",
      "options": {
        "command": "pnpm exec eslint companion/src scripts --ext .ts",
        "cwd": "open-source/zedge"
      }
    }
  }
}
