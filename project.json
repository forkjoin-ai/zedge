{
  "name": "zedge",
  "projectType": "library",
  "sourceRoot": "open-source/zedge/src",
  "tags": ["scope:open-source", "type:lib"],
  "targets": {
    "build": {
      "executor": "a0:run-commands",
      "options": {
        "command": "echo 'zedge: Rust extension built via cargo, companion via gnode'"
      }
    },
    "build:companion": {
      "executor": "a0:run-commands",
      "options": {
        "command": "pnpm exec esbuild open-source/zedge/companion/src/index.ts --bundle --outdir=open-source/zedge/companion/dist --platform=node --format=esm --minify"
      }
    },
    "test": {
      "executor": "a0:run-commands",
      "options": {
        "command": "pnpm exec bun test open-source/zedge/companion/src/__tests__"
      }
    },
    "typecheck": {
      "executor": "a0:run-commands",
      "options": {
        "command": "pnpm exec tsc -p open-source/zedge/companion/tsconfig.typecheck.json --noEmit"
      }
    },
    "lint": {
      "executor": "a0:run-commands",
      "options": {
        "command": "pnpm exec eslint open-source/zedge/companion/src open-source/zedge/scripts --ext .ts"
      }
    }
  }
}
