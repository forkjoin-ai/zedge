{
  "name": "edge-ai",
  "projectType": "library",
  "sourceRoot": "open-source/zedge/src",
  "tags": [
    "scope:open-source",
    "type:lib"
  ],
  "targets": {
    "build": {
      "executor": "a0:run-commands",
      "options": {
        "command": "echo 'zedge: Rust extension built via cargo, companion hosted on x-gnosis + gnode launcher'"
      }
    },
    "build:companion": {
      "executor": "a0:run-commands",
      "options": {
        "command": "pnpm exec esbuild open-source/zedge/companion/src/index.ts --bundle --outdir=open-source/zedge/companion/dist --platform=node --format=esm --minify --packages=external"
      }
    },
    "test": {
      "executor": "a0:run-commands",
      "options": {
        "command": "pnpm run gnode -- test open-source/zedge/companion/src/__tests__"
      }
    },
    "typecheck": {
      "executor": "a0:run-commands",
      "options": {
        "command": "pnpm exec tsc -p open-source/zedge/companion/tsconfig.typecheck.json --noEmit"
      }
    },
    "lint": {
      "executor": "a0:run-commands",
      "options": {
        "command": "pnpm exec eslint open-source/zedge/companion/src open-source/zedge/scripts --ext .ts"
      }
    },
    "github:push": {
      "executor": "a0:run-commands",
      "options": {
        "command": "node scripts/open-source-repo-target.mjs github-push open-source/zedge",
        "cwd": "."
      }
    },
    "forge:push": {
      "executor": "a0:run-commands",
      "options": {
        "command": "node scripts/open-source-repo-target.mjs forge-push open-source/zedge",
        "cwd": "."
      }
    },
    "push": {
      "executor": "a0:run-commands",
      "options": {
        "command": "node scripts/open-source-repo-target.mjs push open-source/zedge",
        "cwd": "."
      }
    },
    "submodule:update-reference": {
      "executor": "a0:run-commands",
      "options": {
        "command": "node scripts/open-source-repo-target.mjs submodule-update-reference open-source/zedge",
        "cwd": "."
      }
    },
    "pr:list": {
      "executor": "a0:run-commands",
      "options": {
        "command": "node scripts/open-source-repo-target.mjs pr-list open-source/zedge",
        "cwd": "."
      }
    },
    "pr:merge-all": {
      "executor": "a0:run-commands",
      "options": {
        "command": "node scripts/open-source-repo-target.mjs pr-merge-all open-source/zedge",
        "cwd": "."
      }
    }
  }
}
