#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")
basedir_win="$basedir"
exe=""
msys=""

case `uname -a` in
  *CYGWIN*|*MINGW*|*MSYS*)
    if command -v cygpath > /dev/null 2>&1; then
      basedir_win=`cygpath -w "$basedir"`
    fi
    exe=".exe"
    msys="true"
  ;;
  *WSL2*)
    if command -v wslpath > /dev/null 2>&1; then
      basedir_win="$(wslpath -w "$basedir" 2> /dev/null)"
      if [ $? -ne 0 ] || [ -z "$basedir_win" ]; then
        basedir_win="$basedir"
      else
        exe=".exe"
      fi
    fi
  ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/Users/buley/Documents/Code/monorepo/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/Users/buley/Documents/Code/monorepo/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -n "$exe" ] && [ -x "$basedir/bun.exe" ]; then
  exec "$basedir/bun.exe"  "$basedir_win/../@a0n/x-gnosis/bin/x-gnosis.ts" "$@"
elif [ -x "$basedir/bun" ]; then
  exec "$basedir/bun"  "$basedir/../@a0n/x-gnosis/bin/x-gnosis.ts" "$@"
elif command -v bun >/dev/null 2>&1; then
  exec bun  "$basedir/../@a0n/x-gnosis/bin/x-gnosis.ts" "$@"
elif [ -n "$exe" ] && command -v bun.exe >/dev/null 2>&1; then
  exec bun.exe  "$basedir_win/../@a0n/x-gnosis/bin/x-gnosis.ts" "$@"
else
  exec bun  "$basedir/../@a0n/x-gnosis/bin/x-gnosis.ts" "$@"
fi
