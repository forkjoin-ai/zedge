{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "src",
    "baseUrl": "../../..",
    "paths": {
      "@a0n/aeon": ["shims/affectively-aeon.ts"],
      "@a0n/aeon/*": ["open-source/aeon/src/*"],
      "@a0n/auth": ["open-source/auth/src/index.ts"],
      "@a0n/auth/*": ["open-source/auth/src/*"],
      "@a0n/distributed-inference-host": [
        "open-source/gnosis/distributed-inference-host/src/index.ts"
      ],
      "@a0n/distributed-inference-host/*": [
        "open-source/gnosis/distributed-inference-host/src/*"
      ],
      "@a0n/bitwise": ["open-source/bitwise/index.ts"],
      "@a0n/bitwise/*": ["open-source/bitwise/src/*", "open-source/bitwise/*"],
      "@a0n/gnosis": ["open-source/gnosis/src/lib.ts"],
      "@a0n/gnosis/*": ["open-source/gnosis/src/*"],
      "@a0n/shared-utils": ["shared-utils/src/index.ts"],
      "@a0n/shared-utils/*": ["shared-utils/src/*"],
      "@a0n/x-gnosis": ["open-source/x-gnosis/src/index.ts"],
      "@a0n/x-gnosis/*": ["open-source/x-gnosis/src/*"]
    },
    "types": ["bun-types", "node"],
    "typeRoots": [
      "../../../node_modules",
      "../../../node_modules/.pnpm/node_modules",
      "../../../node_modules/@types"
    ]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
