{
  "name": "@affectively/zedge-companion",
  "version": "5.0.0",
  "description": "Zedge companion sidecar — inference bridge + compute pool node",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "start": "../scripts/run-ts-entry.sh src/companion-supervisor.ts",
    "direct": "../scripts/run-ts-entry.sh src/index.ts",
    "dev": "node --watch ../../gnosis/bin/gnode.js run src/index.ts --export main",
    "mcp": "../scripts/run-ts-entry.sh src/mcp-stdio.ts",
    "build": "pnpm exec esbuild src/index.ts --bundle --outdir=dist --platform=node --format=esm --minify --packages=external",
    "build:mcp": "pnpm exec esbuild src/mcp-stdio.ts --bundle --outdir=dist --platform=node --format=esm --minify --packages=external"
  },
  "dependencies": {
    "yjs": "^13.6.0",
    "@dashrelay/client": "workspace:*",
    "@affectively/auth": "workspace:*",
    "@affectively/shared-utils": "workspace:*",
    "@a0n/x-gnosis": "workspace:*",
    "@xenova/transformers": "^2.17.2",
    "onnxruntime-node": "^1.23.2"
  },
  "devDependencies": {
    "@types/bun": "^1.3.6",
    "typescript": "^5.9.0"
  },
  "author": "AFFECTIVELY <support@affectively.ai>",
  "license": "MIT"
}
